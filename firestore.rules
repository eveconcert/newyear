rules_version = '2';

// This site never talks to Firestore directly from the browser — every
// read/write goes through a /api/* serverless function using the Admin
// SDK (which bypasses these rules entirely). So the correct rule here is
// simply "deny everything," as a safety net in case client-side Firestore
// access ever gets added later without updating this file.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
